#!/usr/bin/env python3
"""Merge shared Lua modules and one entry file into a single plugin.lua.

The core removes require/dofile/loadfile, and a Lua package may contain exactly
one Lua file, so shared code is inlined at build time:

    python tools/luabundle --main plugin.lua \
        --module cbor=shared/lua/cbor.lua \
        --module commands=shared/lua/commands.lua \
        -o build/plugin.lua

Each module is evaluated in its own closure so module locals cannot collide.
Modules must end with `return M` (a table).
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path


def wrap(name: str, path: Path) -> str:
    source = path.read_text(encoding="utf-8")
    return (
        f"-- module: {name} ({path.name})\n"
        f"local {name} = (function()\n"
        f"{source.rstrip()}\n"
        f"end)()\n\n"
    )


def main() -> int:
    parser = argparse.ArgumentParser(description="Bundle Lua sources")
    parser.add_argument("--main", required=True)
    parser.add_argument("--module", action="append", default=[],
                        help="name=path (repeatable)")
    parser.add_argument("-o", "--output", required=True)
    args = parser.parse_args()

    parts = ["-- generated by tools/luabundle; do not edit\n\n"]
    for spec in args.module:
        if "=" not in spec:
            sys.exit(f"luabundle: --module expects name=path, got '{spec}'")
        name, path = spec.split("=", 1)
        if not name.isidentifier():
            sys.exit(f"luabundle: module name '{name}' is not a Lua identifier")
        parts.append(wrap(name, Path(path)))

    main_path = Path(args.main)
    parts.append(f"-- entry: {main_path.name}\n")
    parts.append(main_path.read_text(encoding="utf-8"))
    if not parts[-1].endswith("\n"):
        parts.append("\n")

    output = Path(args.output)
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text("".join(parts), encoding="utf-8")
    print(f"bundled {len(args.module)} module(s) into {output}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
