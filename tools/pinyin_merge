#!/usr/bin/env python3
"""Merge a curated supplement into the compact pinyin dictionary.

The base dictionary is generated by `tools/pinyin_dictgen` from rime-wanxiang
and trimmed to a compact size. A small supplement adds common phrases that
fall below that trim cutoff but are frequent in chat/daily input (greetings,
holidays, colors, places). The supplement is plain data, not code:

    <space separated syllables>\t<word>\t<frequency>

Merge rules:

- `(key, word)` is unique. The supplement is authoritative: its frequency
  replaces the base value (both raising a common phrase and lowering an
  over-estimate).
- Every syllable must exist in the parser's 413-syllable table and the number
  of syllables must equal the number of Han characters.
- Output is sorted by first letter, key and descending frequency so the
  translator can build one contiguous bucket per starting letter.

    python tools/pinyin_merge --base data/pinyin/pinyin.dict \
        --extra data/pinyin/extra.txt --out data/pinyin/pinyin.dict
"""

from __future__ import annotations

import argparse
import io
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
_HAN = re.compile(r"^[㐀-鿿豈-﫿]+$")


def load_syllables(path: Path) -> set[str]:
    text = path.read_text(encoding="utf-8")
    start = text.index("kSyllables[]")
    begin = text.index('"', start)
    end = text.index(";", begin)
    body = "".join(re.findall(r'"([^"]*)"', text[begin:end]))
    return set(body.split())


def read_entries(path: Path):
    with io.open(path, encoding="utf-8") as handle:
        for number, line in enumerate(handle, 1):
            line = line.rstrip("\n")
            if not line or line[0] == "#":
                continue
            parts = line.split("\t")
            if len(parts) != 3:
                raise SystemExit(f"{path}:{number}: expected 3 tab fields")
            key, word, weight = parts
            try:
                freq = int(weight)
            except ValueError:
                raise SystemExit(f"{path}:{number}: bad frequency {weight!r}")
            yield key, word, freq


def validate(key: str, word: str, syllables: set[str], where: str) -> None:
    parts = key.split()
    if not parts:
        raise SystemExit(f"{where}: empty key")
    if not _HAN.match(word):
        raise SystemExit(f"{where}: word {word!r} is not Han")
    if len(parts) != len(word):
        raise SystemExit(
            f"{where}: {word!r} has {len(word)} chars but {len(parts)} syllables")
    for part in parts:
        if part not in syllables:
            raise SystemExit(f"{where}: unknown syllable {part!r}")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--base", required=True, type=Path)
    parser.add_argument("--extra", required=True, type=Path)
    parser.add_argument("--out", required=True, type=Path)
    parser.add_argument("--syllable-source", type=Path,
                        default=ROOT / "plugins/parse/pime-pinyin-parse/src/plugin.cpp")
    args = parser.parse_args()

    syllables = load_syllables(args.syllable_source)
    if not syllables:
        print("pinyin_merge: empty syllable table", file=sys.stderr)
        return 1

    merged: dict[tuple[str, str], int] = {}
    for key, word, freq in read_entries(args.base):
        slot = (key, word)
        if freq > merged.get(slot, 0):
            merged[slot] = freq
    base_count = len(merged)

    added = updated = 0
    for index, (key, word, freq) in enumerate(read_entries(args.extra)):
        validate(key, word, syllables, f"{args.extra}:{index + 1}")
        slot = (key, word)
        if slot in merged:
            if freq != merged[slot]:
                merged[slot] = freq
                updated += 1
        else:
            merged[slot] = freq
            added += 1

    ordered = sorted(merged.items(),
                     key=lambda item: (item[0][0][0], item[0][0], -item[1]))
    args.out.parent.mkdir(parents=True, exist_ok=True)
    with io.open(args.out, "w", encoding="utf-8", newline="\n") as handle:
        handle.write("# Compact pinyin dictionary derived from rime-wanxiang.\n")
        handle.write("# Source: https://github.com/amzxyz/rime_wanxiang (CC BY 4.0).\n")
        handle.write("# Format: <space separated syllables>\\t<word>\\t<frequency>\n")
        for (key, word), freq in ordered:
            handle.write(f"{key}\t{word}\t{freq}\n")

    print(f"pinyin_merge: base={base_count} added={added} updated={updated} "
          f"total={len(ordered)} -> {args.out}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
